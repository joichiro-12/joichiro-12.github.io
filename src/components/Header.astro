---
const navLinks = [
  { href: '/', label: 'Home' },
];
const pathname = Astro.url.pathname;
---

<header>
  <div class="container header-inner">
    <nav>
      <ul>
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { active: pathname === href || (href !== '/' && pathname.startsWith(href)) }]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    padding-block: 1rem;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-title {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .site-title:hover {
    color: var(--accent);
    text-decoration: none;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
    text-decoration: none;
  }

  .nav-link.active {
    font-weight: 600;
  }
</style>
