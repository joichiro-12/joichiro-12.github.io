---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Joichiro Sato (佐藤 丈一郎) — Master\'s student at Waseda University. AI Engineer Intern at neoAI.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Joichiro Sato",
  "alternateName": "佐藤 丈一郎",
  "url": "https://joichiro-12.github.io",
  "sameAs": [
    "https://github.com/joichiro-12",
    "https://www.linkedin.com/in/joichiro-sato-5b5566352/"
  ],
  "affiliation": {
    "@type": "Organization",
    "name": "Waseda University"
  }
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Joichiro Sato" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Joichiro Sato</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main class="container" style="padding-block: 3rem; flex: 1;">
      <slot />
    </main>
    <Footer />
  </body>
</html>
