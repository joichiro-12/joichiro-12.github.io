---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
---

<BaseLayout title="Home" description="About Joichiro Sato">
  <section class="hero">
    <h1>Joichiro Sato</h1>
    <p class="tagline">Master’s student at Waseda University</p>
  </section>

 <section class="about">
    <h2>About</h2>
    <p class="bio">
      I am interested in dialogue models to help people clarify their thoughts through conversation, not just exchange information.
    </p>
 </section>

  <section class="work-experience">
    <h2>Work Experience</h2>
    <ul class="card-list">
      <li class="card">
        <div class="card-header">
          <span class="card-title">AI Engineer Intern</span>
          <span class="card-period">2024/08 — Present</span>
        </div>
        <a href="https://neoai.jp/" target="_blank" rel="noopener" class="card-org">neoAI</a>
      </li>
      <li class="card">
        <div class="card-header">
          <span class="card-title">Research Assistant</span>
          <span class="card-period">2026/05 — Present</span>
        </div>
        <a href="https://llmc.nii.ac.jp/" target="_blank" rel="noopener" class="card-org">NII Research and Development Center for Large Language Models</a>
      </li>
    </ul>
  </section>

  <section class="education">
    <h2>Education</h2>
    <ul class="card-list">
      <li class="card">
        <div class="card-header">
          <span class="card-title">M.E. in Computer Science and Communications Engineering</span>
          <span class="card-period">2026/04 — Present</span>
        </div>
        <span class="card-org">Waseda University, Tokyo Japan</span>
        <span class="card-meta">Supervisor: <a href="https://sites.google.com/site/ogatetsu/eng/" class="card-meta-link">Tetsuji Ogawa</a></span>
        <span class="card-meta">Co-Supervisor: <a href="https://www.pcl.cs.waseda.ac.jp/?members=kobayashi" class="card-meta-link">Kobayashi Tetsunori</a></span>
      </li>
      <li class="card">
        <div class="card-header">
          <span class="card-title">B.E. in Computer Science and Communications Engineering</span>
          <span class="card-period">2022/04 — 2026/03</span>
        </div>
        <span class="card-org">Waseda University, Tokyo Japan</span>
        <span class="card-meta">Supervisor: <a href="https://sites.google.com/site/ogatetsu/eng/" class="card-meta-link">Tetsuji Ogawa</a></span>
        <span class="card-meta">Co-Supervisor: <a href="https://www.pcl.cs.waseda.ac.jp/?members=kobayashi" class="card-meta-link">Kobayashi Tetsunori</a></span>
        <span class="card-meta">Thesis: <a href="https://ken.ieice.org/ken/paper/202603030ct3/" class="card-meta-link">Context Dependency in Automatic Speech Recognition: Analyzing Mamba's Effectiveness </a></span>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.25rem;
  }

  .tagline {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  .about {
    margin-bottom: 3rem;
  }

  .bio {
    max-width: 540px;
    color: var(--text);
    line-height: 1.8;
    margin: 0;
  }

  .work-experience,
  .education {
    margin-bottom: 3rem;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.875rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .card-title {
    font-weight: 500;
  }

  .card-period {
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .card-org {
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  a.card-org:hover {
    color: var(--accent);
  }

  .card-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .card-meta-link {
    color: inherit;
    text-decoration: none;
  }

  .card-meta-link:hover {
    color: var(--accent);
  }

  .recent-posts h2 {
    margin-bottom: 0.75rem;
  }

  .post-list {
    list-style: none;
    margin-bottom: 1rem;
  }

  .post-list li {
    border-bottom: 1px solid var(--border);
  }

  .post-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.75rem;
    color: var(--text);
  }

  .post-list a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .all-posts-link {
    font-size: 0.9rem;
  }
</style>
